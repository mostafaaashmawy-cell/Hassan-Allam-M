# Server Port
PORT=5000

# Your Google Account Email
GMAIL_USER=your-email@gmail.com

# Your Google 16-Character App Password (NOT your account password)
# Guide to create: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Recipient email address where you want to receive lead submissions
# If left empty, it will default to sending to GMAIL_USER
RECIPIENT_EMAIL=your-recipient-email@gmail.com
